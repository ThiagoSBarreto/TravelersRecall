<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Frame name="TravelersRecallFrame"
           parent="UIParent"
           hidden="true"
           movable="true"
           enableMouse="true"
           clampedToScreen="true"
           frameStrata="DIALOG">

        <Size>
            <AbsDimension x="320" y="540"/>
        </Size>

        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>

        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
                  edgeFile="Interface\DialogFrame\UI-DialogBox-Border"
                  tile="true">
            <BackgroundInsets>
                <AbsInset left="11" right="12" top="12" bottom="11"/>
            </BackgroundInsets>
            <TileSize>
                <AbsValue val="32"/>
            </TileSize>
            <EdgeSize>
                <AbsValue val="32"/>
            </EdgeSize>
        </Backdrop>

        <Layers>
            <Layer level="ARTWORK">
                <Texture name="$parentHeader"
                         file="Interface\DialogFrame\UI-DialogBox-Header">
                    <Size>
                        <AbsDimension x="256" y="64"/>
                    </Size>
                    <Anchors>
                        <Anchor point="TOP">
                            <Offset>
                                <AbsDimension x="0" y="12"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>

        <Frames>
            <Frame name="TravelersRecallStatusFrame">
                <Size>
                    <AbsDimension x="190" y="16"/>
                </Size>
                <Anchors>
                    <Anchor point="BOTTOMLEFT">
                        <Offset>
                            <AbsDimension x="22" y="19"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString name="TravelersRecallStatusText"
                                    inherits="GameFontDisableSmall"
                                    justifyH="LEFT">
                            <Anchors>
                                <Anchor point="LEFT"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>

            <EditBox name="TravelersRecallSearchBox"
                     inherits="InputBoxTemplate"
                     autoFocus="false">
                <Size>
                    <AbsDimension x="176" y="20"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="30" y="-38"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnEscapePressed>
                        this:ClearFocus();
                    </OnEscapePressed>
                    <OnEnterPressed>
                        this:ClearFocus();
                    </OnEnterPressed>
                </Scripts>
            </EditBox>

            <Button name="TravelersRecallSortButton"
                    inherits="UIPanelButtonTemplate">
                <Size>
                    <AbsDimension x="84" y="22"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="-20" y="-37"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Button>

            <CheckButton name="TravelersRecallReadyOnlyCheck"
                         inherits="UICheckButtonTemplate">
                <Size>
                    <AbsDimension x="24" y="24"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="20" y="-60"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </CheckButton>

            <ScrollFrame name="TravelersRecallScrollFrame"
                         enableMouseWheel="true">
                <Size>
                    <AbsDimension x="252" y="400"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="22" y="-88"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </ScrollFrame>

            <Slider name="TravelersRecallScrollBar"
                    inherits="UIPanelScrollBarTemplate"
                    orientation="VERTICAL">
                <Size>
                    <AbsDimension x="16" y="368"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT"
                            relativeTo="TravelersRecallScrollFrame"
                            relativePoint="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="6" y="-16"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <MinMaxValues>
                    <AbsValue val="0"/>
                    <AbsValue val="0"/>
                </MinMaxValues>
                <ValueStep>
                    <AbsValue val="1"/>
                </ValueStep>
            </Slider>
        </Frames>

        <Scripts>
            <OnLoad>
                local frame = this
                frame:RegisterForDrag("LeftButton")

                local title = frame:CreateFontString(nil, "OVERLAY", "GameFontNormal")
                title:SetPoint("TOP", 0, -2)
                title:SetText("Traveler's Recall")
                title:SetTextColor(1, 0.82, 0)
                frame.legacyTitle = title

                local closeButton = CreateFrame("Button", nil, frame, "UIPanelButtonTemplate")
                closeButton:SetWidth(90)
                closeButton:SetHeight(22)
                closeButton:SetPoint("BOTTOMRIGHT", frame, "BOTTOMRIGHT", -16, 16)
                closeButton:SetText("Close")
                closeButton:SetScript("OnClick", function()
                    local parent = this:GetParent()
                    if parent then
                        parent:Hide()
                    end
                end)
                frame.legacyCloseButton = closeButton
            </OnLoad>

            <OnDragStart>
                this:StartMoving();
            </OnDragStart>

            <OnDragStop>
                this:StopMovingOrSizing();
            </OnDragStop>
        </Scripts>
    </Frame>
</Ui>